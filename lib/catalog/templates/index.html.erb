<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page_title %></title>
  <meta name="description" content="<%= page_description %>">
<% unless page_url.empty? -%>
  <link rel="canonical" href="<%= page_url %>">
<% end -%>

  <!-- Open Graph / sdílení (Mastodon, Facebook, …) -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= page_title %>">
  <meta property="og:title" content="<%= page_title %>">
  <meta property="og:description" content="<%= page_description %>">
<% unless page_url.empty? -%>
  <meta property="og:url" content="<%= page_url %>">
<% end -%>
  <meta property="og:image" content="<%= share_image %>">
  <meta property="og:image:width" content="1600">
  <meta property="og:image:height" content="840">
  <meta property="og:image:alt" content="Zprávobot — maskot v oranžovém skafandru">
  <meta property="og:locale" content="cs_CZ">

  <!-- Twitter / X card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= page_title %>">
  <meta name="twitter:description" content="<%= page_description %>">
  <meta name="twitter:image" content="<%= share_image %>">

  <link rel="stylesheet" href="app.css">
</head>
<body data-updated="<%= updated_iso %>">
  <header class="site-header">
    <div class="hero">
      <button class="hero-link" id="hero-home" type="button" aria-label="Zobrazit všechny zdroje">
        <img class="hero-img" src="header.jpg" width="1600" height="840"
             alt="Zprávobot — maskot v oranžovém skafandru drží telefon zbnw">
      </button>
      <div class="hero-overlay hero-overlay-tl">
        <h1><span class="brand-prefix" data-i18n="brand_prefix">Katalog</span> <span class="brand-domain">Zprávobot.news</span></h1>
        <p class="claim" data-i18n="claim">Objev své oblíbené zdroje na Mastodonu</p>
      </div>
      <div class="hero-overlay hero-overlay-tr lang-switch" id="lang-switch" aria-label="Jazyk / Language">
        <button type="button" data-lang="cs">CZ</button>
        <span class="lang-sep" aria-hidden="true">|</span>
        <button type="button" data-lang="en">EN</button>
      </div>
      <a class="hero-overlay hero-overlay-br main-account"
         href="https://zpravobot.news"
         target="_blank" rel="noopener">Zpravobot.news</a>
    </div>
  </header>

  <nav class="tabs" id="tabs" aria-label="Řezy katalogu">
    <button class="tab is-active" data-slice="all" data-i18n="nav_all">Vše</button>
    <span class="tab-sep" data-i18n="nav_platform">Platforma</span>
    <button class="tab" data-slice="platform:twitter">X</button>
    <button class="tab" data-slice="platform:bluesky">Bluesky</button>
    <button class="tab" data-slice="platform:facebook">Facebook</button>
    <button class="tab" data-slice="platform:instagram">Instagram</button>
    <button class="tab" data-slice="platform:threads">Threads</button>
    <button class="tab" data-slice="platform:youtube">YouTube</button>
    <button class="tab" data-slice="platform:rss">RSS</button>
    <span class="tab-sep" data-i18n="nav_charts">Žebříčky</span>
    <button class="tab" data-slice="top:followers:10" data-i18n="nav_top10_foll">Top 10 sledovaných</button>
    <button class="tab" data-slice="top:active:10" data-i18n="nav_top10_active">Top 10 aktivních</button>
    <button class="tab" data-slice="top:followers:50" data-i18n="nav_top50_foll">Top 50 sledovaných</button>
    <button class="tab" data-slice="top:active:50" data-i18n="nav_top50_active">Top 50 aktivních</button>
    <span class="tab-sep" data-i18n="nav_risers">Skokani týdne</span>
    <button class="tab" data-slice="top:gain_followers:10" data-i18n="nav_risers_foll">V sledujících</button>
    <button class="tab" data-slice="top:gain_activity:10" data-i18n="nav_risers_active">V aktivitě</button>
    <span class="tab-sep" data-i18n="nav_new">Novinky</span>
    <button class="tab" data-slice="recent" data-i18n="nav_recent">Nedávno přidané</button>
    <p class="tabs-count"><strong id="visible-count"><%= account_count %></strong> <span data-i18n="count_of">z</span> <span id="total-count"><%= account_count %></span> <span data-i18n="count_sources">zdrojů</span></p>
  </nav>

  <main class="layout">
    <aside class="sidebar" id="sidebar">
      <button class="sidebar-toggle" id="sidebar-toggle" aria-expanded="false" aria-controls="sidebar-body">
        <span data-i18n="filters_toggle">Filtry</span> <span class="sidebar-toggle-icon" aria-hidden="true">▾</span>
      </button>

      <div class="sidebar-body" id="sidebar-body">
        <div class="filter-search">
          <label for="search" data-i18n="search_label">Vyhledat</label>
          <input type="search" id="search" placeholder="Jméno nebo handle…" data-i18n-ph="search_ph" autocomplete="off">
        </div>

        <div class="filter-sort">
          <label for="sort" data-i18n="sort_label">Řadit</label>
          <select id="sort">
            <option value="name" data-i18n="sort_name">Abecedně</option>
            <option value="followers" data-i18n="sort_followers">Nejvíc sledujících</option>
            <option value="posts" data-i18n="sort_posts">Nejaktivnější</option>
            <option value="added" data-i18n="sort_added">Nejnověji přidané</option>
          </select>
        </div>

        <section class="filter-group" data-filter="family">
          <h2 data-i18n="head_topic">Oblast</h2>
          <div class="filter-buttons">
            <button class="filter-btn fam-business" data-value="business" data-i18n="fam_business">Byznys</button>
            <button class="filter-btn fam-humor" data-value="humor" data-i18n="fam_humor">Humor</button>
            <button class="filter-btn fam-culture" data-value="culture" data-i18n="fam_culture">Kultura</button>
            <button class="filter-btn fam-sport" data-value="sport" data-i18n="fam_sport">Sport</button>
            <button class="filter-btn fam-government" data-value="government" data-i18n="fam_government">Stát</button>
            <button class="filter-btn fam-science_tech" data-value="science_tech" data-i18n="fam_science_tech">Věda &amp; technika</button>
            <button class="filter-btn fam-news" data-value="news" data-i18n="fam_news">Zprávy</button>
            <button class="filter-btn fam-lifestyle" data-value="lifestyle" data-i18n="fam_lifestyle">Životní styl</button>
          </div>
        </section>

        <section class="filter-group" data-filter="type">
          <h2 data-i18n="head_type">Typ účtu</h2>
          <div class="filter-buttons">
            <button class="filter-chip" data-value="institution">Instituce/Organizace</button>
            <button class="filter-chip" data-value="media" data-i18n="type_media">Médium</button>
            <button class="filter-chip" data-value="person" data-i18n="type_person">Osoba</button>
            <button class="filter-chip" data-value="other" data-i18n="type_other">Ostatní</button>
            <button class="filter-chip" data-value="team" data-i18n="type_team">Tým</button>
          </div>
        </section>

        <section class="filter-group" data-filter="language">
          <h2 data-i18n="head_language">Jazyk</h2>
          <div class="filter-buttons">
            <button class="filter-chip" data-value="cs" data-i18n="lang_cs">Čeština</button>
            <button class="filter-chip" data-value="sk" data-i18n="lang_sk">Slovenčina</button>
            <button class="filter-chip" data-value="en" data-i18n="lang_en">English</button>
          </div>
        </section>

        <section class="filter-group filter-tags" data-filter="tag">
          <h2 data-i18n="head_tag">Tag</h2>
          <div id="tag-selected" class="tag-selected"></div>
          <div class="tag-autocomplete">
            <input type="text" id="tag-input" placeholder="Filtr podle tagu…" data-i18n-ph="tag_ph" autocomplete="off"
                   role="combobox" aria-expanded="false" aria-controls="tag-suggestions" aria-autocomplete="list">
            <ul id="tag-suggestions" class="tag-suggestions" role="listbox" hidden></ul>
          </div>
          <div id="tag-chips" class="tag-chips"></div>
        </section>

        <button id="reset-filters" class="reset-btn" data-i18n="reset" hidden>Zrušit filtry</button>
      </div>
    </aside>

    <section class="catalog">
      <p id="slice-note" class="slice-note" hidden></p>

      <div id="loading-state" class="loading-state">
        <span class="spinner" aria-hidden="true"></span> <span data-i18n="loading">Načítám katalog…</span>
      </div>

      <div id="cards" class="cards-grid" aria-live="polite"></div>

      <div id="empty-state" class="empty-state" hidden>
        <p data-i18n="empty_title">Žádný zdroj neodpovídá filtrům.</p>
        <p class="empty-hint" data-i18n="empty_hint">Zkus uvolnit některý z filtrů.</p>
        <button id="empty-reset" class="reset-btn" data-i18n="empty_reset">Reset filtrů</button>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p><span data-i18n="footer_updated">Katalog naposledy aktualizován</span> <strong><%= updated_label %></strong><span id="updated-relative" class="updated-relative"></span>.</p>
      <p><span data-i18n="footer_owner">Jsi vlastník účtu a chceš jej z katalogu odstranit? Napiš na</span>
        <a href="https://zpravobot.news/@<%= main_account.split('@')[1] %>" target="_blank" rel="noopener"><%= main_account %></a>.</p>
    </div>
  </footer>

  <dialog id="detail-modal" class="detail-modal" aria-label="Detail zdroje"></dialog>

  <script src="app.js"></script>
</body>
</html>
